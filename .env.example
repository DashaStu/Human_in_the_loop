# Провайдер модели: ollama или deepseek
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen25_local
OLLAMA_BASE_URL=http://localhost:11434

# Если используете DeepSeek API вместо Ollama:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Опционально: локальный прокси для Telegram
# TELEGRAM_PROXY=http://127.0.0.1:10809
